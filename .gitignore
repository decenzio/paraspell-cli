# Dependencies
node_modules/
.pnpm-store/

# Logs and debug
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and secrets
.env
.env.*
!.env.example

# TypeScript — emit lives next to sources under src/ (see package.json "build": "tsc")
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
src/**/*.d.ts.map

# Bundler / app output (templates and future root apps)
dist/
build/
*.local

# Vite
.vite/

# Test coverage
coverage/
.nyc_output/

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
*.swp
*.swo

# Tooling caches
.eslintcache
.prettiercache
*.tsbuildinfo
.turbo/
.cache/

# Hygen workspace (local installs / generated examples)
xcm-sdk-hygen/node_modules/
xcm-sdk-hygen/generated/

# Pack artifacts
*.tgz
