{
  "name": "@paraspell/xcm-sdk-hygen",
  "private": true,
  "version": "1.0.0",
  "description": "Hygen generators for ParaSpell XCM SDK and XCM API templates (React, Vue, Node)",
  "scripts": {
    "generate:sdk": "node scripts/generate-sdk.mjs",
    "generate:sdk:react": "node scripts/generate-sdk-react.mjs",
    "generate:sdk:vue": "node scripts/generate-sdk-vue.mjs",
    "generate:sdk:node": "node scripts/generate-sdk-node.mjs",
    "generate:sdk:examples": "node scripts/generate-sdk-examples.mjs",
    "generate:sdk:examples:react": "node scripts/generate-sdk-examples-react.mjs",
    "generate:sdk:examples:vue": "node scripts/generate-sdk-examples-vue.mjs",
    "generate:sdk:examples:node": "node scripts/generate-sdk-examples-node.mjs",
    "generate:xcm-api": "node scripts/generate-xcm-api.mjs",
    "generate:xcm-api:react": "node scripts/generate-xcm-api-react.mjs",
    "generate:xcm-api:vue": "node scripts/generate-xcm-api-vue.mjs",
    "generate:xcm-api:node": "node scripts/generate-xcm-api-node.mjs",
    "generate:xcm-api:examples": "node scripts/generate-xcm-api-examples.mjs",
    "bootstrap:sdk": "npm run bootstrap:sdk:react && npm run bootstrap:sdk:vue && npm run bootstrap:sdk:node",
    "bootstrap:sdk:react": "node scripts/bootstrap-sdk-react-templates.mjs",
    "bootstrap:sdk:vue": "node scripts/bootstrap-sdk-vue-templates.mjs",
    "bootstrap:sdk:node": "node scripts/bootstrap-sdk-node-templates.mjs",
    "bootstrap:xcm-api": "npm run bootstrap:xcm-api:react && npm run bootstrap:xcm-api:vue && npm run bootstrap:xcm-api:node",
    "bootstrap:xcm-api:react": "node scripts/bootstrap-xcm-api-react-templates.mjs",
    "bootstrap:xcm-api:vue": "node scripts/bootstrap-xcm-api-vue-templates.mjs",
    "bootstrap:xcm-api:node": "node scripts/bootstrap-xcm-api-node-templates.mjs"
  },
  "dependencies": {
    "hygen": "^6.2.11"
  }
}
